# Postgres connection used by the app at runtime (Neon: the pooled URL).
DATABASE_URL=
# Direct connection used for migrations (Neon: the unpooled URL). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Signs session cookies. 32+ random characters: `openssl rand -base64 48`.
AUTH_SECRET=

# Encrypts stored account secrets (AES-256-GCM). Base64 of 32 random bytes: `openssl rand -base64 32`.
# Keep it safe and never change it without re-encrypting: lost key = unreadable secrets.
SECRETS_ENCRYPTION_KEY=

# Public base URL of the app, e.g. https://tools.codeacme.com
NEXT_PUBLIC_APP_URL=

# Login rate limiting (Upstash Redis). Optional locally, required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: pino log level (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=

# Used only by `pnpm db:seed` to create the first admin account.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
