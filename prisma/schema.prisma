generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String  @id @default(cuid())
  name         String  @db.VarChar(255)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  role         Role    @default(MEMBER)
  // Bumped on every password change/reset; sessions issued under an older version are rejected,
  // so a reset revokes every open session immediately.
  sessionVersion Int     @default(0)
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientMemberships ClientMember[]
  timeEntries       TimeEntry[]
  updatedAccounts   Account[]           @relation("AccountUpdatedBy")
  accountEvents     AccountAuditEvent[]
  passwordResets    PasswordResetToken[]
  toolAccess        UserToolAccess[]
  workSessions      WorkSession[]

  @@index([role])
}

model Client {
  id                  String   @id @default(cuid())
  name                String   @db.VarChar(255)
  slug                String   @unique @db.VarChar(255)
  contactName         String?  @db.VarChar(255)
  // Retainer cap. Null means the client has no monthly limit.
  monthlyLimitMinutes Int?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members     ClientMember[]
  categories  TimeCategory[]
  timeEntries TimeEntry[]
  accounts    Account[]
  projects    Project[]
  invoices    Invoice[]
  workSessions WorkSession[]

  @@index([isArchived])
}

model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

model TimeCategory {
  id         String   @id @default(cuid())
  clientId   String
  name       String   @db.VarChar(255)
  sortOrder  Int
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  timeEntries TimeEntry[]

  @@unique([clientId, name])
  @@index([clientId])
}

model TimeEntry {
  id              String   @id @default(cuid())
  clientId        String
  userId          String
  categoryId      String?
  workDate        DateTime @db.Date
  durationMinutes Int
  task            String   @db.Text
  requestedBy     String?  @db.VarChar(255)
  link            String?  @db.VarChar(2048)
  // Structured version of the "??" marks in the old notes: time the logger is not sure about.
  needsReview     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category TimeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  workSession WorkSession?

  @@index([clientId, workDate])
  @@index([userId, workDate])
  @@index([categoryId])
}

enum AccountAccessLevel {
  MASTER
  ADMIN
  USER
}

enum AccountAuditAction {
  CREATED
  UPDATED
  SECRET_CHANGED
  REVEALED
  COPIED
  ARCHIVED
  RESTORED
}

model Account {
  id          String      @id @default(cuid())
  // Null means a CodeAcme internal account, visible to admins only.
  clientId    String?
  name        String      @db.VarChar(255)
  purpose     String?     @db.VarChar(1000)
  accessLevel AccountAccessLevel?
  url         String?     @db.VarChar(2048)
  username    String?     @db.VarChar(255)
  twoFactor   String?     @db.VarChar(255)
  notes       String?     @db.Text
  // Where the real credential is kept. Null means not recorded yet.
  storageLocation SecretLocation?
  // e.g. "Bitwarden › The 30k Club collection" or "Anna's shared Google Drive".
  locationNote    String?         @db.VarChar(500)
  // AES-256-GCM ciphertext ("v1.<iv>.<tag>.<data>"); never sent to the browser except on reveal.
  secretCiphertext      String?   @db.Text
  secureNotesCiphertext String?   @db.Text
  secretUpdatedAt       DateTime?
  isArchived  Boolean     @default(false)
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client      Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  updatedBy   User?               @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditEvents AccountAuditEvent[]

  @@index([clientId])
  @@index([isArchived])
}

model AccountAuditEvent {
  id        String             @id @default(cuid())
  accountId String
  userId    String
  action    AccountAuditAction
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([createdAt])
}

model WorkSession {
  id          String    @id @default(cuid())
  userId      String
  clientId    String?
  note        String?   @db.VarChar(500)
  startedAt   DateTime
  // Null while the timer is running; each user has at most one running session.
  endedAt     DateTime?
  // Time actually worked, excluding pauses. Null for sessions recorded before pausing existed,
  // where the worked time is simply endedAt - startedAt.
  workedSeconds Int?
  // Set once the session has been turned into a Time Tracking entry.
  timeEntryId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
}

// A single-use "forgot password" link. Only a SHA-256 hash of the token is stored, so a database
// leak cannot be turned into working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ToolAccessLevel {
  VIEW
  EDIT
}

// Which tools a member may open, and whether they may change things there. Admins have every tool
// implicitly and have no rows. toolId matches an id in src/config/tools.ts.
model UserToolAccess {
  id        String          @id @default(cuid())
  userId    String
  toolId    String          @db.VarChar(64)
  level     ToolAccessLevel
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

// A piece of work outside the monthly retainer, e.g. a Booking MVP. Actual time is what it really
// took (often less, thanks to AI); billed time is what the client is told and invoiced for.
model Project {
  id            String        @id @default(cuid())
  clientId      String
  name          String        @db.VarChar(255)
  description   String?       @db.Text
  status        ProjectStatus @default(ACTIVE)
  actualMinutes Int?
  billedMinutes Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([clientId, name])
}

// Saved "pay us here" details (bank, Wise, ...) that an invoice copies when it is created.
model PaymentProfile {
  id          String   @id @default(cuid())
  label       String   @db.VarChar(255)
  details     String   @db.Text
  paymentLink String?  @db.VarChar(2048)
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

model Invoice {
  id             String        @id @default(cuid())
  // INV-2026-001: sequential per calendar year of the issue date.
  number         String        @unique @db.VarChar(32)
  clientId       String
  projectId      String?
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  currency       String        @default("USD") @db.VarChar(3)
  // Payment details are copied, so editing a saved profile never changes a sent invoice.
  paymentDetails String        @db.Text
  paymentLink    String?       @db.VarChar(2048)
  terms          String?       @db.Text
  notes          String?       @db.Text
  status         InvoiceStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines   InvoiceLine[]

  @@index([clientId])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String @db.VarChar(500)
  minutes     Int
  // Hourly rate in cents, so money never goes through floating point.
  rateCents   Int
  sortOrder   Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// The last invoice number used per year; bumped inside the transaction that creates the invoice.
model InvoiceSequence {
  year       Int @id
  lastNumber Int
}

enum SecretLocation {
  TOOLS_VAULT
  BITWARDEN
  ONE_PASSWORD
  CLIENT_HOLDS
  OTHER
}
